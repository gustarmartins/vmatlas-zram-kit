#!/usr/bin/env python3
"""Target-scoped ZRAM residency actions for vmatlas-zram-kit.

`pageout` uses process_madvise(MADV_PAGEOUT) on a single caller-owned process.
`warm` reads only page-table entries that are actually swapped, then faults
those ranges back into memory.  Neither operation is global swapoff.
"""

from __future__ import annotations

import argparse
import ctypes
import ctypes.util
import errno
import fcntl
import os
import platform
import pwd
import re
import shutil
import struct
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Iterator


PROC = Path("/proc")
PAGE_SIZE = os.sysconf("SC_PAGE_SIZE")
GIB = 1024**3
MIB = 1024**2
MADV_PAGEOUT = 21
IOV_MAX = 128
PAGEMAP_ENTRY_SIZE = 8
PAGEMAP_SWAPPED = 1 << 62
PAGEMAP_PRESENT = 1 << 63
SCAN_PAGES = 8192
READ_CHUNK = 1 * MIB
CHECK_EVERY = 64 * MIB
HEADER_RE = re.compile(
    r"^([0-9a-fA-F]+)-([0-9a-fA-F]+)[ \t]+([rwxps-]+)[ \t]+"
    r"\S+[ \t]+\S+[ \t]+\S+(?:[ \t]+(.*))?$",
    re.MULTILINE,
)


class ProcessActionError(RuntimeError):
    """Raised when an action is unavailable or its safety contract is not met."""


class IOVec(ctypes.Structure):
    _fields_ = (("iov_base", ctypes.c_void_p), ("iov_len", ctypes.c_size_t))


@dataclass(frozen=True)
class Target:
    pid: int
    start_ticks: int
    uid: int
    comm: str
    rss: int
    swap: int


@dataclass(frozen=True)
class MemoryState:
    total: int
    available: int
    swap_total: int
    swap_used: int
    memory_some: float
    memory_full: float


@dataclass(frozen=True)
class Region:
    start: int
    end: int
    rss: int
    swap: int
    name: str


def fmt(value: int) -> str:
    amount = max(float(value), 0.0)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if amount < 1024 or unit == "TiB":
            return f"{amount:.1f} {unit}" if unit != "B" else f"{int(amount)} B"
        amount /= 1024
    raise AssertionError("unreachable")


def caller_uid() -> int:
    """Keep the original sudo caller as the authority boundary."""
    if os.geteuid() == 0 and os.environ.get("SUDO_UID", "").isdigit():
        return int(os.environ["SUDO_UID"])
    return os.getuid()


def read_status(pid: int) -> dict[str, str]:
    values: dict[str, str] = {}
    with (PROC / str(pid) / "status").open(encoding="ascii", errors="replace") as source:
        for line in source:
            key, separator, value = line.partition(":")
            if separator:
                values[key] = value.strip()
    return values


def status_bytes(status: dict[str, str], key: str) -> int:
    try:
        return int(status.get(key, "0 kB").split()[0]) * 1024
    except (IndexError, ValueError):
        return 0


def process_start_ticks(pid: int) -> int:
    content = (PROC / str(pid) / "stat").read_text(encoding="ascii", errors="replace")
    closing = content.rfind(")")
    if closing < 0:
        raise ProcessActionError(f"PID {pid} has an invalid stat record")
    fields = content[closing + 2 :].split()
    try:
        return int(fields[19])
    except (IndexError, ValueError) as error:
        raise ProcessActionError(f"PID {pid} has an invalid start time") from error


def capture_target(pid: int, expected: Target | None = None) -> Target:
    if pid <= 1 or pid == os.getpid():
        raise ProcessActionError(f"refusing PID {pid}")
    try:
        status = read_status(pid)
        target = Target(
            pid=pid,
            start_ticks=process_start_ticks(pid),
            uid=int(status["Uid"].split()[0]),
            comm=(PROC / str(pid) / "comm").read_text(encoding="utf-8", errors="replace").strip(),
            rss=status_bytes(status, "VmRSS"),
            swap=status_bytes(status, "VmSwap"),
        )
    except (OSError, KeyError, IndexError, ValueError) as error:
        raise ProcessActionError(f"PID {pid} exited or cannot be inspected") from error
    if expected and (
        target.start_ticks != expected.start_ticks
        or target.uid != expected.uid
        or target.comm != expected.comm
    ):
        raise ProcessActionError(f"PID {pid} changed identity during the operation")
    return target


def read_memory_state() -> MemoryState:
    values: dict[str, int] = {}
    with open("/proc/meminfo", encoding="ascii") as source:
        for line in source:
            key, separator, rest = line.partition(":")
            fields = rest.split()
            if separator and fields and fields[0].isdigit():
                values[key] = int(fields[0]) * 1024

    def psi(kind: str) -> float:
        try:
            with open("/proc/pressure/memory", encoding="ascii") as source:
                for line in source:
                    if line.startswith(kind + " "):
                        for field in line.split():
                            if field.startswith("avg10="):
                                return float(field.split("=", 1)[1])
        except (OSError, ValueError):
            pass
        return 0.0

    total = values.get("MemTotal", 0)
    swap_total = values.get("SwapTotal", 0)
    return MemoryState(
        total=total,
        available=values.get("MemAvailable", 0),
        swap_total=swap_total,
        swap_used=max(swap_total - values.get("SwapFree", 0), 0),
        memory_some=psi("some"),
        memory_full=psi("full"),
    )


def active_swap() -> bool:
    try:
        return len((PROC / "swaps").read_text(encoding="ascii").splitlines()) > 1
    except OSError:
        return False


def safe_limit(state: MemoryState) -> int:
    """A portable upper bound: 1/4 RAM, never over 2 GiB, minimum 512 MiB."""
    return min(2 * GIB, max(512 * MIB, state.total // 4))


def reserve(state: MemoryState) -> int:
    return max(1 * GIB, state.total // 8)


def state_summary(state: MemoryState) -> str:
    return (
        f"available {fmt(state.available)}, swap {fmt(state.swap_used)}/{fmt(state.swap_total)}, "
        f"memory PSI some/full avg10 {state.memory_some:.2f}%/{state.memory_full:.2f}%"
    )


def require_owner(target: Target) -> None:
    owner = caller_uid()
    if target.uid != owner:
        try:
            name = pwd.getpwuid(owner).pw_name
        except KeyError:
            name = str(owner)
        raise ProcessActionError(
            f"PID {target.pid} belongs to UID {target.uid}; this tool only targets its caller ({name}, UID {owner})"
        )


def safe_gate(target: Target, action: str) -> tuple[MemoryState, int]:
    state = read_memory_state()
    limit = safe_limit(state)
    if not active_swap():
        raise ProcessActionError("no active swap device; refusing an action marketed as ZRAM residency control")
    if state.available < reserve(state):
        raise ProcessActionError(
            f"MemAvailable is {fmt(state.available)}, below the {fmt(reserve(state))} reserve"
        )
    if state.memory_some >= 15.0 or state.memory_full >= 2.0:
        raise ProcessActionError(
            f"memory pressure is active ({state.memory_some:.2f}%/{state.memory_full:.2f}% some/full avg10)"
        )
    measured = target.rss if action == "pageout" else target.swap
    label = "VmRSS" if action == "pageout" else "VmSwap"
    if measured > limit:
        raise ProcessActionError(
            f"target {label} is {fmt(measured)}, above the portable safe limit {fmt(limit)}"
        )
    if action == "warm" and state.available < target.swap + reserve(state):
        raise ProcessActionError(
            f"warming {fmt(target.swap)} needs target swap plus {fmt(reserve(state))} reserve; "
            f"only {fmt(state.available)} is available"
        )
    return state, limit


def parse_regions(pid: int) -> list[Region]:
    content = (PROC / str(pid) / "smaps").read_text(encoding="ascii", errors="replace")
    headers = list(HEADER_RE.finditer(content))
    regions: list[Region] = []
    for index, match in enumerate(headers):
        permissions = match.group(3)
        name = (match.group(4) or "").strip() or "[anon]"
        if "r" not in permissions or name in {"[vvar]", "[vdso]", "[vsyscall]"}:
            continue
        end = headers[index + 1].start() if index + 1 < len(headers) else len(content)
        block = content[match.end() : end]
        flags = re.search(r"^VmFlags:\s+(.+)$", block, re.MULTILINE)
        if flags and "lo" in flags.group(1).split():
            continue
        rss_match = re.search(r"^Rss:\s+(\d+)\s+kB", block, re.MULTILINE)
        swap_match = re.search(r"^Swap:\s+(\d+)\s+kB", block, re.MULTILINE)
        rss = int(rss_match.group(1)) * 1024 if rss_match else 0
        swap = int(swap_match.group(1)) * 1024 if swap_match else 0
        if rss == 0 and swap == 0:
            continue
        regions.append(
            Region(
                start=int(match.group(1), 16),
                end=int(match.group(2), 16),
                rss=rss,
                swap=swap,
                name=name,
            )
        )
    return regions


def print_target(target: Target, regions: list[Region]) -> None:
    print(
        f"Target PID {target.pid} ({target.comm}): RSS {fmt(target.rss)}, VmSwap {fmt(target.swap)}, "
        f"{len(regions)} readable/unlocked mappings"
    )
    print(
        f"  mapping totals: RSS {fmt(sum(region.rss for region in regions))}, "
        f"Swap {fmt(sum(region.swap for region in regions))}"
    )
    for region in sorted(regions, key=lambda item: item.rss + item.swap, reverse=True)[:5]:
        print(
            f"  0x{region.start:012x} RSS {fmt(region.rss):>10} Swap {fmt(region.swap):>10} {region.name}"
        )


def libc_process_madvise():
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    function = getattr(libc, "process_madvise", None)
    if function is not None:
        function.restype = ctypes.c_ssize_t
        function.argtypes = (
            ctypes.c_int,
            ctypes.POINTER(IOVec),
            ctypes.c_size_t,
            ctypes.c_int,
            ctypes.c_uint,
        )
        return lambda pidfd, vectors, count: function(pidfd, vectors, count, MADV_PAGEOUT, 0)

    if platform.machine().lower() not in {"x86_64", "amd64", "aarch64", "arm64"}:
        raise ProcessActionError("process_madvise is unavailable in libc on this architecture")
    syscall = libc.syscall
    syscall.restype = ctypes.c_long
    return lambda pidfd, vectors, count: syscall(440, pidfd, vectors, count, MADV_PAGEOUT, 0)


def pidfd_open(pid: int) -> int:
    if hasattr(os, "pidfd_open"):
        return os.pidfd_open(pid, 0)
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    if platform.machine().lower() not in {"x86_64", "amd64", "aarch64", "arm64"}:
        raise ProcessActionError("pidfd_open is unavailable on this architecture")
    result = libc.syscall(434, ctypes.c_int(pid), ctypes.c_uint(0))
    if result < 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code))
    return int(result)


def pageout(target: Target, regions: list[Region], dry_run: bool) -> None:
    # Keep the action focused on anonymous mappings.  Evicting mapped source,
    # APK, library, or project files would be ordinary file-cache management,
    # not a predictable "put this process into ZRAM" request.
    eligible = [region for region in regions if region.rss > 0 and region.name.startswith("[")]
    print(
        f"Pageout candidates: {len(eligible)} anonymous mappings, "
        f"{fmt(sum(region.rss for region in eligible))} resident RSS"
    )
    if dry_run:
        print("Dry run: no process_madvise call was made.")
        return
    before = capture_target(target.pid, target)
    descriptor = pidfd_open(target.pid)
    advise = libc_process_madvise()
    advised = 0
    errors = 0
    try:
        for offset in range(0, len(eligible), IOV_MAX):
            capture_target(target.pid, target)
            batch = eligible[offset : offset + IOV_MAX]
            vectors = (IOVec * len(batch))()
            for index, region in enumerate(batch):
                vectors[index].iov_base = ctypes.c_void_p(region.start)
                vectors[index].iov_len = ctypes.c_size_t(region.end - region.start)
            ctypes.set_errno(0)
            result = advise(descriptor, vectors, len(batch))
            if result < 0:
                code = ctypes.get_errno()
                errors += 1
                print(f"  batch {offset // IOV_MAX + 1}: kernel refused advice: {os.strerror(code)}")
                continue
            advised += int(result)
    finally:
        os.close(descriptor)
    time.sleep(1.0)
    after = capture_target(target.pid, target)
    print(
        f"Observed result: RSS {fmt(before.rss)} -> {fmt(after.rss)}; "
        f"VmSwap {fmt(before.swap)} -> {fmt(after.swap)}"
    )
    print(
        f"Kernel accepted MADV_PAGEOUT for {fmt(advised)} virtual bytes across {len(eligible)} mappings; "
        f"{errors} batch(es) refused. Accepted advice is not proof of bytes written to ZRAM."
    )


def swapped_runs(pagemap_fd: int, region: Region) -> Iterator[tuple[int, int]]:
    page = region.start // PAGE_SIZE
    final_page = (region.end + PAGE_SIZE - 1) // PAGE_SIZE
    while page < final_page:
        count = min(SCAN_PAGES, final_page - page)
        data = os.pread(pagemap_fd, count * PAGEMAP_ENTRY_SIZE, page * PAGEMAP_ENTRY_SIZE)
        entries = len(data) // PAGEMAP_ENTRY_SIZE
        run_start: int | None = None
        for offset in range(entries):
            entry = struct.unpack_from("Q", data, offset * PAGEMAP_ENTRY_SIZE)[0]
            swapped = bool(entry & PAGEMAP_SWAPPED) and not bool(entry & PAGEMAP_PRESENT)
            address = (page + offset) * PAGE_SIZE
            if swapped and run_start is None:
                run_start = address
            if run_start is not None and (not swapped or offset == entries - 1):
                yield run_start, address if not swapped else address + PAGE_SIZE
                run_start = None
        page += max(entries, 1)


def assert_still_safe(target: Target, warmed: int, limit: int, force: bool) -> None:
    capture_target(target.pid, target)
    if force:
        return
    state = read_memory_state()
    if warmed > limit:
        raise ProcessActionError(f"warm limit reached: {fmt(warmed)} > {fmt(limit)}")
    if state.available < reserve(state):
        raise ProcessActionError(f"MemAvailable fell below the {fmt(reserve(state))} reserve")
    if state.memory_some >= 15.0 or state.memory_full >= 2.0:
        raise ProcessActionError(
            f"memory pressure rose to {state.memory_some:.2f}%/{state.memory_full:.2f}% some/full avg10"
        )


def warm(target: Target, regions: list[Region], force: bool, dry_run: bool, limit: int) -> None:
    candidates = [region for region in regions if region.swap > 0]
    print(f"Warm candidates: {len(candidates)} mappings reporting {fmt(sum(region.swap for region in candidates))} swapped")
    if not candidates:
        print("Target has no swapped mappings to fault in.")
        return
    try:
        pagemap_fd = os.open(PROC / str(target.pid) / "pagemap", os.O_RDONLY | os.O_CLOEXEC)
        mem_fd = os.open(PROC / str(target.pid) / "mem", os.O_RDONLY | os.O_CLOEXEC)
    except OSError as error:
        raise ProcessActionError(f"cannot inspect target pagemap/memory: {error}") from error
    detected = 0
    touched = 0
    try:
        for region in candidates:
            for start, end in swapped_runs(pagemap_fd, region):
                detected += end - start
                if dry_run:
                    continue
                cursor = start
                while cursor < end:
                    if touched == 0 or touched % CHECK_EVERY == 0:
                        assert_still_safe(target, touched, limit, force)
                    length = min(READ_CHUNK, end - cursor)
                    try:
                        data = os.pread(mem_fd, length, cursor)
                    except OSError as error:
                        if error.errno in {errno.EIO, errno.EFAULT, errno.EPERM}:
                            print(f"  skipped a protected/invalid range: {error}")
                            break
                        raise
                    if not data:
                        break
                    touched += len(data)
                    cursor += len(data)
    finally:
        os.close(mem_fd)
        os.close(pagemap_fd)
    if dry_run:
        print(f"Dry run: found {fmt(detected)} of PTEs currently marked swapped; no memory was touched.")
        return
    after = capture_target(target.pid, target)
    print(
        f"Observed result: touched {fmt(touched)} of {fmt(detected)} swapped PTE bytes; "
        f"VmSwap is now {fmt(after.swap)}, RSS {fmt(after.rss)}."
    )


def action_lock() -> object:
    lock_path = Path("/run/lock/vmatlas-zram-process.lock")
    descriptor = lock_path.open("w", encoding="ascii")
    try:
        fcntl.flock(descriptor.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as error:
        descriptor.close()
        raise ProcessActionError("another vmatlas-zram process action is running") from error
    return descriptor


def sudo_reexec() -> None:
    sudo = shutil.which("sudo")
    if not sudo:
        raise ProcessActionError("root access is required and sudo was not found")
    print("Re-executing with root access for process_madvise/pagemap access.")
    os.execv(sudo, [sudo, "--", sys.executable, os.path.realpath(__file__), *sys.argv[1:]])


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Target-scoped manual process residency controls for ZRAM systems.",
        epilog=(
            "Safe inspection:  vmatlas-zram process inspect PID\n"
            "Safe pageout:     vmatlas-zram process pageout PID\n"
            "Safe warm:        vmatlas-zram process warm PID\n"
            "Preview:          vmatlas-zram process warm PID --dry-run\n"
            "Intentional bypass: vmatlas-zram process warm PID --force --confirm-pid PID"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("action", choices=("inspect", "pageout", "warm"))
    parser.add_argument("pid", type=int, metavar="PID")
    parser.add_argument("--dry-run", action="store_true", help="inspect the exact target without changing memory")
    parser.add_argument("--force", action="store_true", help="bypass only RAM/PSI/size gates for this exact PID")
    parser.add_argument("--confirm-pid", type=int, metavar="PID", help="repeat PID to confirm --force")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        if args.force and args.confirm_pid != args.pid:
            raise ProcessActionError("--force requires --confirm-pid with the exact same PID")
        if args.confirm_pid is not None and not args.force:
            raise ProcessActionError("--confirm-pid is valid only with --force")

        target = capture_target(args.pid)
        require_owner(target)
        regions = parse_regions(target.pid)
        state = read_memory_state()
        print(f"Initial state: {state_summary(state)}")
        print_target(target, regions)

        if args.action == "inspect":
            return 0
        if not args.dry_run and os.geteuid() != 0:
            sudo_reexec()
            raise AssertionError("sudo exec returned")

        if args.force:
            print(
                "FORCE mode: RAM-headroom, PSI, and per-target size gates are bypassed. "
                "Process identity and caller ownership checks remain enforced."
            )
            limit = 1 << 62
        else:
            safe_state, limit = safe_gate(target, args.action)
            print(f"Safe gate passed: limit {fmt(limit)}; {state_summary(safe_state)}")

        if args.dry_run:
            # A preview changes neither the target nor ZRAM state.  Keeping it
            # out of /run/lock makes a non-root preview work on normal systems.
            if args.action == "pageout":
                pageout(target, regions, dry_run=True)
            else:
                warm(target, regions, args.force, dry_run=True, limit=limit)
        else:
            with action_lock():
                if args.action == "pageout":
                    pageout(target, regions, dry_run=False)
                else:
                    warm(target, regions, args.force, dry_run=False, limit=limit)
        return 0
    except ProcessActionError as error:
        print(f"vmatlas-zram process: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
