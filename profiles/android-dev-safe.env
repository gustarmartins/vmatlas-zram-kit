# Profile metadata. install.sh renders host-scaled values; do not source this file.
name=android-dev-safe
zram_size=min(ram*2,32GiB)
zram_resident_limit=ram/2
primary_compression=zstd-level-3
secondary_compression=off
writeback=off
swappiness=120
vfs_cache_pressure=60
page_cluster=0
mglru_ttl=1000ms-on-8GiB-or-less;2000ms-otherwise
description=Portable derivative of the retained Android build workstation profile.
