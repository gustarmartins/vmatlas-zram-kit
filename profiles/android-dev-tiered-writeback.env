# Deliberately not installable without --writeback-device and confirmation.
name=android-dev-tiered-writeback
inherits=android-dev-tiered
writeback=dedicated-empty-unmounted-raw-partition-only
cold_pass=256MiB
cold_boot_cap=4096MiB
idle_age=86400s
timer=disabled-by-default
description=Tiered ZRAM plus explicitly provisioned, budgeted raw-device writeback.
