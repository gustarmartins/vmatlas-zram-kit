# Requires a live capability proof from a first safe-profile boot.
name=android-dev-tiered
inherits=android-dev-safe
primary_compression=zstd-level-3
secondary_compression=zstd-level-12-priority-1
recompression=manual-only
writeback=off
description=Adds an idle-page zstd recompression tier when the kernel exposes multi-compressor ZRAM.
