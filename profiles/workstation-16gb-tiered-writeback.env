# Workstation 16GB Tiered Writeback Profile (Codex/AGY Verified Baseline)
name=workstation-16gb-tiered-writeback
zram_size=ram*2.25
zram_resident_limit=ram/1.6
primary_compression=lz4
tier1_compression=zstd:3
tier2_compression=zstd:9
tier3_compression=zstd:15
writeback=dedicated-empty-unmounted-raw-partition-only
cold_pass=256MiB
cold_boot_cap=4096MiB
idle_age=1800s
swappiness=142
vfs_cache_pressure=68
min_free_kbytes=131072
watermark_scale_factor=92
watermark_boost_factor=16155
page_cluster=0
compaction_proactiveness=0
compact_unevictable_allowed=1
dirty_bytes=1342177280
dirty_background_bytes=78643200
dirty_writeback_centisecs=150
dirty_expire_centisecs=1000
mglru_enabled=0x0007
mglru_ttl_ms=2000
description=Full 4-tier memory hierarchy (LZ4 -> ZSTD3 -> ZSTD9 -> ZSTD15 -> NVMe) with validated 16GB sysctl parameters.
