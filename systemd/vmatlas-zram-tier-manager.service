[Unit]
Description=Adaptive multi-tier zram recompression and writeback manager
Documentation=https://github.com/gustarmartins/vmatlas-zram-kit
ConditionPathExists=/run/vmatlas-tier/levels
After=systemd-zram-setup@zram0.service swap.target
Wants=systemd-zram-setup@zram0.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/vmatlas-zram-tier-manager run
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
